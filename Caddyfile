# ==============================================================================
# GESCOM — configuration du frontal web
#
# Caddy remplit trois rôles :
#   1. terminaison TLS, avec obtention et renouvellement automatiques du
#      certificat Let's Encrypt — il n'y a aucune clé à gérer à la main ;
#   2. service des fichiers statiques du SPA compilé ;
#   3. relais des appels /api vers l'API Spring Boot.
#
# Le point important est le troisième : le SPA et l'API sortent sous le même
# domaine. Le navigateur n'émet donc jamais de requête inter-origines, la
# configuration CORS de SecurityConfig ne s'applique plus à l'usage normal, et
# le JWT ne franchit aucune frontière d'origine.
# ==============================================================================
{
	# Adresse à laquelle Let's Encrypt signale l'expiration d'un certificat.
	#
	# Elle doit être réelle et relevée : ce n'est pas un champ de courtoisie.
	# Une adresse en example.com fait rejeter la création du compte par
	# Let's Encrypt — « HTTP 400 urn:ietf:params:acme:error:invalidContact -
	# contact email has forbidden domain "example.com" » — et Caddy bascule
	# alors silencieusement sur l'émetteur de repli (ZeroSSL).
	#
	# ACME_EMAIL vient de .env. La valeur après ':' n'est un repli que si la
	# variable est absente de l'environnement : Caddy ne la substitue pas
	# lorsqu'elle est présente et vide. Or docker-compose la définit toujours —
	# c'est pourquoi le repli est doublé côté compose, en ${ACME_EMAIL:-...}.
	# Celui-ci ne sert donc qu'à un lancement de Caddy hors compose.
	email {$ACME_EMAIL:mackaldine22@gmail.com}
}

# Le domaine vient de APP_DOMAIN (.env), passé au conteneur par docker-compose.
# Volontairement sans valeur de repli : une variable absente rend le bloc de site
# vide et Caddy s'arrête sur une erreur de configuration, au lieu de servir
# l'application sous un nom qui n'est pas celui du déploiement.
{$APP_DOMAIN} {
	encode zstd gzip

	# --------------------------------------------------------------------------
	# API
	#
	# Le préfixe /api n'est pas retiré : les contrôleurs Spring sont mappés sur
	# /api/... et le context-path de l'application est resté '/'.
	#
	# Seul /api/* est relayé. Tout le reste de l'API — dont /swagger-ui/** et
	# /v3/api-docs — est par construction injoignable depuis l'extérieur, en plus
	# d'être déjà couvert par le `anyRequest().authenticated()` de SecurityConfig.
	# --------------------------------------------------------------------------
	handle /api/* {
		reverse_proxy api:8085
	}

	# --------------------------------------------------------------------------
	# SPA
	#
	# try_files renvoie index.html pour toute route inconnue : les URL de
	# react-router (/commandes, /produits/12…) n'existent pas sur le disque et
	# doivent être résolues côté client, pas rendues en 404.
	# --------------------------------------------------------------------------
	handle {
		root * /srv

		# Les fichiers de dist/assets portent une empreinte dans leur nom : un
		# changement de contenu change l'URL, ils peuvent donc être mis en cache
		# indéfiniment. index.html, lui, ne doit jamais l'être, sinon un
		# déploiement reste invisible pour les navigateurs déjà venus.
		@fingerprinted path /assets/*
		header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}

	# --------------------------------------------------------------------------
	# En-têtes de sécurité, appliqués à toutes les réponses
	# --------------------------------------------------------------------------
	header {
		# Impose HTTPS pour les visites suivantes, y compris si l'utilisateur
		# tape l'adresse sans schéma.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# Interdit au navigateur de deviner un type MIME différent de celui
		# annoncé — parade classique au contenu téléversé rejoué en script.
		X-Content-Type-Options "nosniff"
		# L'application n'a pas vocation à être embarquée dans une iframe.
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Aucune fonctionnalité sensible n'est utilisée par le SPA.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# Limite les dégâts d'une injection de contenu : même si une chaîne
		# hostile parvenait jusqu'au DOM, le navigateur refuserait d'exécuter le
		# script ou de joindre le serveur du tiers. Directive par directive :
		#
		#   script-src 'self'   Vite ne produit aucun script en ligne — le seul
		#                       <script> d'index.html est un module externe
		#                       empreinté. Ni 'unsafe-inline' ni nonce à prévoir.
		#   style-src           'unsafe-inline' est ici incompressible : React
		#                       pose des attributs style= (style={{…}}), que la
		#                       CSP bloque au même titre qu'une balise <style>,
		#                       et framer-motion anime de la même façon. Le CDN
		#                       de Google Fonts est appelé depuis index.html.
		#   img-src data:       les graphiques Recharts et les aperçus jsPDF
		#                       passent par des images encodées en ligne.
		#   connect-src 'self'  suffit parce que Caddy sert le SPA et relaie
		#                       l'API sous le même domaine (voir l'en-tête de ce
		#                       fichier). À élargir si l'API en sortait.
		#   frame-ancestors     équivalent moderne du X-Frame-Options ci-dessus,
		#                       conservé le temps que les vieux navigateurs
		#                       sortent du parc.
		#
		# Les téléchargements (exports CSV, PDF) ouvrent des URL blob: par un
		# <a download> : c'est une navigation, elle n'est régie par aucune de ces
		# directives et reste donc fonctionnelle.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		# Ne pas annoncer le serveur ni sa version.
		-Server
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
		}
	}
}
