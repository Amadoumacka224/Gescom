# ==============================================================================
# GESCOM — fichiers exclus du versionnement
#
# Ce dépôt héberge deux applications : l'API Spring Boot (Maven, à la racine) et
# le client React/Vite sous FRONT/, qui conserve son propre .gitignore pour ses
# artefacts locaux.
#
# Rappel : ces règles n'ont AUCUN effet sur un fichier déjà suivi par git.
# Pour cesser de suivre un fichier committé par erreur :
#     git rm --cached <fichier>
# ==============================================================================

# ------------------------------------------------------------------------------
# Build Maven / Java
# ------------------------------------------------------------------------------
target/
!**/src/main/**/target/
!**/src/test/**/target/
*.class

# Archives produites par le build. Le jar du wrapper Maven fait exception : il se
# versionne, c'est ce qui permet de construire le projet sans installer Maven.
*.jar
*.war
*.ear
!.mvn/wrapper/maven-wrapper.jar

# Diagnostics de plantage de la JVM
hs_err_pid*
replay_pid*
*.hprof
.attach_pid*

# ------------------------------------------------------------------------------
# Frontend / Node
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
stats.html
.eslintcache
.npm/
.pnpm-store/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Configuration locale, secrets et environnement
#
# L'application lit ses paramètres sensibles depuis l'environnement (DB_URL,
# JWT_SECRET, STRIPE_API_KEY…) : aucun de ces fichiers ne doit être committé.
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

application-local.properties
application-*-local.properties
src/main/resources/application-local.properties

# Certificats, clés et magasins de clés
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# ------------------------------------------------------------------------------
# Base de données
#
# Les dumps contiennent des données et restent hors du dépôt. Les scripts de
# migration, eux, DOIVENT être versionnés : les exceptions ci-dessous évitent
# qu'un futur passage à Flyway ou Liquibase soit silencieusement ignoré.
# ------------------------------------------------------------------------------
*.sql
*.sql.gz
*.dump
*.bak
!db/schema.sql
!src/main/resources/db/migration/**/*.sql
!src/main/resources/db/changelog/**/*.sql

# ------------------------------------------------------------------------------
# Journaux et fichiers temporaires
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.tmp
*.temp
*.swp
*.swo
*~
.cache/

# ------------------------------------------------------------------------------
# IDE et éditeurs
# ------------------------------------------------------------------------------

# IntelliJ IDEA (out/ est son répertoire de compilation)
.idea/
out/
*.iml
*.ipr
*.iws

# Eclipse / Spring Tool Suite
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# VS Code : les réglages partagés d'équipe restent versionnés
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ------------------------------------------------------------------------------
# Systèmes d'exploitation
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ------------------------------------------------------------------------------
# Divers
# ------------------------------------------------------------------------------
HELP.md

